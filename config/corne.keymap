#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        OpenParenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        OpenBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <18 19>;
        };

        OpenBracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <30 31>;
        };

        CloseParenthasis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <8 7>;
        };

        CloseBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
        };

        CloseBracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <31 32>;
        };

        LessThan {
            bindings = <&kp LESS_THAN>;
            key-positions = <3 4>;
        };

        GreatherThan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <4 5>;
        };

        PrintScrn {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <0 1>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <37 40>;
        };

        AltF4 {
            bindings = <&kp LA(F4)>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | ENTR |
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   | ./, | '/" |  /* | EQU |
            //                    | GUI | LWR | SPC |   | SPC | L2   | L1  |

            bindings = <
&kp ESCAPE  &kp Q         &kp W        &kp E           &kp R       &kp T        &kp Y      &kp U          &kp I       &kp O        &kp P                 &kp GRAVE
&kp EQUAL   &mt LSHIFT A  &mt LCTRL S  &mt LEFT_WIN D  &mt LALT F  &kp G        &kp H      &mt RALT J     &mt RWIN K  &mt RCTRL L  &mt RSHIFT SEMICOLON  &kp APOSTROPHE
&kp MINUS   &kp Z         &kp X        &kp C           &kp V       &kp B        &kp N      &kp M          &kp COMMA   &kp DOT      &kp SLASH             &kp BACKSLASH
                                       &mo 1           &kp TAB     &kp SPACE    &kp ENTER  &kp BACKSPACE  &mo 2
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // | BOOT |     |     |     |     |     |   |     |  1  |  2  |  3  |  0  | BOOT |
            // |      |     |     | UP  |     |     |   |     |  4  |  5  |  6  |     |      |
            // |      |     | LFT | DWN | RGT |     |   |     |  7  |  8  |  9  |     |      |
            //                    |     |     | SPC |   | SPC |     |     |

            bindings = <
&none   &mmv MOVE_LEFT         &mmv MOVE_DOWN        &mmv MOVE_UP       &mmv MOVE_RIGHT       &trans    &mkp LCLK     &kp NUMBER_7            &kp NUMBER_8       &kp NUMBER_9                &none            &bootloader
&trans  &mt LSHIFT LEFT_ARROW  &mt LCTRL DOWN_ARROW  &mt LWIN UP_ARROW  &mt LALT RIGHT_ARROW  &trans    &mkp RCLK     &mt RIGHT_ALT NUMBER_4  &mt RWIN NUMBER_5  &mt RIGHT_CONTROL NUMBER_6  &kp RIGHT_SHIFT  &trans
&trans  &trans                 &none                 &none              &none                 &trans    &kp NUMBER_0  &kp NUMBER_1            &kp NUMBER_2       &kp NUMBER_3                &trans           &trans
                                                     &trans             &trans                &none     &none         &trans                  &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  &  |  %  |   |  ^  |  $  |  *  |  (  |  )  | BSPC |
            // | CTRL |MUTE |V_UP |V_DWN|  <  |  >  |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | SPC |     |     |

            bindings = <
&kp TAB    &kp EXCL    &kp AT             &kp HASH         &kp DOLLAR     &kp PRCNT           &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LPAR  &kp RPAR  &none
&kp LCTRL  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp LESS_THAN  &kp GREATER_THAN    &kp MINUS  &kp EQUAL      &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &caps_word  &trans             &trans           &trans         &trans              &kp UNDER  &kp PLUS       &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                          &trans           &trans         &none               &none      &trans         &trans
            >;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            // |      | BT 1 | BT 2 | BT 3 | BT 4 | BT 5 |   |     |     |     |     |     |      |
            // |BT_CLR|      |      |      |      |      |   |     |     |     |     |     |BT_CLR|
            // |OUT_TG|CLRALL|      |      |      |      |   |     |     |     |     |     |      |
            //                      |      |      |      |   |     |     |     |

            bindings = <
&out OUT_TOG    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none   &none   &none   &none  &none  &none
&bt BT_CLR      &none         &none         &none         &none         &none           &none   &none   &none   &none  &none  &none
&bt BT_CLR_ALL  &none         &none         &none         &none         &bootloader     &none   &none   &none   &none  &none  &sys_reset
                                            &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
